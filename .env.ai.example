# RT swim lab 環境変数テンプレート
# このファイルを .env.ai にコピーし、値を設定してください。
# cp .env.ai.example .env.ai
#
# 重要: このファイルには機密情報（シークレット等）を書かないでください。
# 本ファイルは Git にコミットされます。実際の値は .env.ai にのみ記載してください。
#
# 本プロジェクトは next.config で .env.ai を読み込みます（.env.local ではない）。
# 設定後、開発サーバーを再起動してください。

# ===========================================
# Google OAuth（ログイン必須）
# ===========================================
# GOOGLE_CLIENT_ID = Google Cloud Console で作成したウェブアプリケーションのクライアントID
# GOOGLE_CLIENT_SECRET = クライアントシークレット（Console で確認）
#
# 承認済みリダイレクトURI に以下を登録：
#   http://localhost:3000/api/auth/callback/google
#   https://rt-swimlab-web-tl3a.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=264483404131-h524bs0g0ms73corpjvtmgav09iojcpq.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# ===========================================
# NextAuth
# ===========================================
# NEXTAUTH_SECRET = openssl rand -base64 32 で生成した文字列
NEXTAUTH_SECRET=
# 本番（Vercel）のみ。例: https://rt-swimlab-web-tl3a.vercel.app
# NEXTAUTH_URL=

# ===========================================
# OpenAI API（カスタム作成に必要）
# ===========================================
# OPENAI_API_KEY = カスタム作成を使う場合のみ設定。クイック作成は不要。
OPENAI_API_KEY=
