# RT swim lab 環境変数テンプレート
# 
# 使い方:
#   1. このファイルを .env.ai にコピー:  cp .env.ai.example .env.ai
#   2. 下記の = の右側に値を入れる（クォート不要、スペース不要）
#   3. npm run dev を再起動
#
# 重要: .env.ai は Git に含まれません。機密情報はここにのみ記載してください。

# ===========================================
# Supabase（必須：サインアップ・ログイン・マイページ）
# ===========================================
# 取得先: supabase.com → プロジェクト → Settings → API

# ← ここに Project URL（例: https://xxxxx.supabase.co）を入れる
NEXT_PUBLIC_SUPABASE_URL=

# ← ここに anon (public) キーを入れる
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 注意: Authentication → Providers → Email を有効化すること。
# Confirm email をオフにすると登録後すぐログイン可能。

# Google ログイン（任意・Supabase で Google プロバイダーを有効にした場合のみ）
# NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true

# マイグレーション実行用（npm run db:migrate）
# Dashboard → Settings → Database → Connection string (URI)
# DATABASE_URL=postgresql://postgres.xxxxx:PASSWORD@aws-0-xx.pooler.supabase.com:6543/postgres

# ===========================================
# 外部リンク（マイページのメニューバーに表示）
# ===========================================
# RT公式LINE（友だち追加URL。例: https://line.me/R/ti/p/@xxxxx）
# NEXT_PUBLIC_LINE_URL=

# コミュニティサイトURL
# NEXT_PUBLIC_COMMUNITY_URL=

# ドリル練習（マイページに「ドリル練習」ナビを出す。未設定または false のときは非表示）
# NEXT_PUBLIC_DRILL_PRACTICE_ENABLED=true

# ===========================================
# 開発用バイパス（ローカルでログインできないときのみ）
# ===========================================
# 本番では絶対に設定しないこと。NODE_ENV=development のときのみ有効。
# ログイン画面に「開発用で入る」ボタンが表示される。
# DEV_BYPASS_USER_ID は profiles に存在するユーザーID（auth.users の id）を指定。
# Supabase Dashboard → Authentication → Users で UUID をコピー。
# バイパス時は SUPABASE_SERVICE_ROLE_KEY も必要（Settings → API → service_role）。
# DEV_BYPASS_AUTH=true
# DEV_BYPASS_USER_ID=
# NEXT_PUBLIC_DEV_BYPASS_AUTH=true
# NEXT_PUBLIC_DEV_BYPASS_USER_ID=
# SUPABASE_SERVICE_ROLE_KEY=

# ===========================================
# OpenAI API（任意：カスタム作成のみ必要）
# ===========================================
# クイック作成は不要。platform.openai.com から取得。
OPENAI_API_KEY=

# モデル（省略時は gpt-4o-mini）。最新は platform.openai.com → Models で確認。
# 例: gpt-4o（高精度・高コスト）、gpt-4o-mini（軽量・低コスト）
# OPENAI_MODEL=gpt-4o-mini

# Web検索API（任意・演習内容の質向上用）。serper.dev で無料枠 2500 回/月
# 設定時、専門的クエリで最新の水泳情報を検索しプロンプトに追加
# SERPER_API_KEY=
