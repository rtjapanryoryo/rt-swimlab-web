{
  "name": "swimcoach-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup:env": "test -f .env.ai || cp .env.ai.example .env.ai; echo '→ .env.ai を用意しました。未設定なら編集して Supabase の値を入れてください。'",
    "setup:env:interactive": "node scripts/setup-env-interactive.mjs",
    "set:env": "node scripts/set-env.mjs",
    "fix:supabase": "node scripts/fix-supabase-env.mjs",
    "verify:supabase": "node scripts/verify-supabase.mjs",
    "supabase:disable-email-confirm": "node scripts/disable-email-confirmation.mjs",
    "db:migrate": "node scripts/run-migration.mjs",
    "db:push": "node scripts/db-push.mjs",
    "web:fetch": "node scripts/fetch-web-sources.mjs",
    "simulate:menu-distance": "node scripts/simulate-custom-menu-distance.mjs",
    "db:setup": "open 'https://supabase.com/dashboard/project/lpzrrblueipqhgtttzlw/settings/database'",
    "supabase:link": "node scripts/supabase-link.mjs",
    "supabase:push": "npx supabase db push",
    "dev": "node scripts/load-env-and-dev.mjs",
    "dev:next": "next dev",
    "dev:3001": "next dev -p 3001",
    "dev:unix": "lsof -ti :3000 2>/dev/null | xargs kill -9 2>/dev/null; true; npm run dev",
    "dev:daemon": "pm2 start ecosystem.config.cjs",
    "dev:daemon:stop": "pm2 stop rt-swimlab-web",
    "dev:daemon:logs": "pm2 logs rt-swimlab-web",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.98.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.0.0",
    "next": "^15.4.3",
    "nodemailer": "^8.0.6",
    "openai": "^6.17.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^4.0.379",
    "pdfpressor-client": "^0.2.52",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "stripe": "^22.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.1.3",
    "pg": "^8.20.0",
    "pm2": "^5.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
