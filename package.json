{
  "name": "swimcoach-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "lsof -ti :3000 2>/dev/null | xargs kill -9 2>/dev/null; true",
    "setup:env": "test -f .env.ai || cp .env.ai.example .env.ai; echo '→ .env.ai を用意しました。未設定なら編集して Supabase の値を入れてください。'",
    "setup:env:interactive": "node scripts/setup-env-interactive.mjs",
    "set:env": "node scripts/set-env.mjs",
    "fix:supabase": "node scripts/fix-supabase-env.mjs",
    "verify:supabase": "node scripts/verify-supabase.mjs",
    "supabase:disable-email-confirm": "node scripts/disable-email-confirmation.mjs",
    "db:migrate": "node scripts/run-migration.mjs",
    "dev": "node scripts/load-env-and-dev.mjs",
    "dev:next": "next dev",
    "dev:3001": "next dev -p 3001",
    "dev:daemon": "pm2 start ecosystem.config.cjs",
    "dev:daemon:stop": "pm2 stop rt-swimlab-web",
    "dev:daemon:logs": "pm2 logs rt-swimlab-web",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.98.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.0.0",
    "next": "^15.4.3",
    "openai": "^6.17.0",
    "pdf-parse": "^2.4.5",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.1.3",
    "pm2": "^5.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
