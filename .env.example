# ============================================================
# OpenAI API キー（カスタム作成で使用）
# ============================================================
# 原因: 未設定と出るのは (1) このキーが無い (2) YOUR_API_KEY_HERE のまま (3) 設定後にサーバーを再起動していない
# 対処: 本番では .env.local を用意し、下を本物のキーに書き換えてから「npm run dev」をやり直す
OPENAI_API_KEY=YOUR_API_KEY_HERE

# Google OAuth（NextAuth）
# https://console.cloud.google.com/ で OAuth 2.0 クライアントIDを作成
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# NextAuth の秘密鍵（openssl rand -base64 32 で生成）
NEXTAUTH_SECRET=your-nextauth-secret

# 本番ではデプロイ先のURL（例: https://your-app.vercel.app）
NEXTAUTH_URL=http://localhost:3000
