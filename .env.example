# ============================================================
# OpenAI API キー（カスタム作成で使用）
# ============================================================
# ※ .env.local がエクスプローラーでグレー表示されるのは .gitignore で無視しているためです（秘密情報をコミットしないため）。正常です。
#
# 「OpenAI API: 未設定」が出る場合:
# 1) このファイルをコピーして .env.local を作成し、OPENAI_API_KEY= に本物のキーを書く（値はクォートで囲まない）
# 2) 保存後、必ず開発サーバーを再起動する（npm run dev を一度止めてから再度実行）
# 3) YOUR_API_KEY_HERE や空のままにしない
OPENAI_API_KEY=YOUR_API_KEY_HERE

# Google OAuth（NextAuth）
# https://console.cloud.google.com/ で OAuth 2.0 クライアントIDを作成
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# NextAuth の秘密鍵（openssl rand -base64 32 で生成）
NEXTAUTH_SECRET=your-nextauth-secret

# 本番ではデプロイ先のURL（例: https://your-app.vercel.app）
NEXTAUTH_URL=http://localhost:3000
